# Development Environment Configuration
# Copy this file to .env.dev and modify as needed

# API Keys (use test/development keys)
NEWS_API_KEY=your_dev_news_api_key_here
REDDIT_USER_AGENT=NewsAggregator-Dev/1.0

# Data Source Configuration
DATA_SOURCE=database
# Options: memory, database

# Database Configuration (Development)
DATABASE_URL=postgresql://postgres:password@db:5432/newsdb_dev

# Application Settings
APP_NAME=News Aggregator (Development)
APP_VERSION=1.0.0-dev
DEBUG=true
LOG_LEVEL=DEBUG

# Security (Development - use weak keys for development only)
SECRET_KEY=dev-secret-key-not-for-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# Rate Limiting (Relaxed for development)
RATE_LIMIT_PER_MINUTE=1000

# Cache Settings
REDIS_URL=redis://redis:6379/0
CACHE_TTL=60

# External APIs
NEWS_API_BASE_URL=https://newsapi.org/v2
REDDIT_API_BASE_URL=https://www.reddit.com

# Development specific settings
PYTEST_WORKERS=auto
PYTEST_COVERAGE=true

# Jupyter settings
JUPYTER_ENABLE_LAB=yes
JUPYTER_TOKEN=dev-token

# Database connection pool (development)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# HTTP Client settings (development)
REQUEST_TIMEOUT=30
MAX_RETRIES=3
